# Local development only. Gitignored, never uploaded, never used by a deploy.
# Points the Worker at the local B2 stand-in so the real handler runs without an
# account:   node tools/b2-stand-in.mjs 8090 <seedDir>
B2_API_URL=http://127.0.0.1:8090/b2api/v2
B2_DOWNLOAD_URL=http://127.0.0.1:8090
B2_KEY_ID=test-key-id
B2_APPLICATION_KEY=test-app-key
BUCKET_NAME=esmeringhoy-media
MEDIA_SIGNING_KEY=dev-signing-key-not-secret

# Wrangler dev simulates the production hostname, so a browser's POST reaches
# the Worker with that origin while the page itself is browsed at localhost.
SITE_ORIGINS=http://localhost:8787,http://esmeringhoy.eu.cc

# Local-only password for /stats, added so the Statistics tab is testable here.
# Not used in production; the deployed token lives in Cloudflare secrets.
STATS_TOKEN=local-dev-token
